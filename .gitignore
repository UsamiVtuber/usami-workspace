# Segredos — jamais versionar
.env
.qoder/settings.local.json

# Assets de terceiros e pacotes grandes (fora do git)
*.zip
*.glb
*.vrm
Vrms/
CubismSdkForWeb-5-r.5/
Felis_v0.8.1/
autumn-original-work/

_backup/

# Dados locais do Obsidian: privados, nunca vão para um remoto.
# (A regra `usami/` abaixo só os encobria por case-insensitive do Windows.)
vault/

# Estado de runtime escrito a partir da raiz quando um script roda sem cd usami/
/data/

# Skills locais: cache de terceiros que o agente consulta quando precisa.
# Não é conteúdo do projeto e é regenerável pelo skills-lock.json dentro dele.
Agents/

# Projetos de terceiros usados só como referência de ideias (não são do Usami)
airi/
OpenAmika/

# Repo próprio (ferramenta de observabilidade, versionada à parte)
usami-monitor/

# Repo aninhado com versionamento próprio
usami/

# Repo próprio do motor 3D WeebUI (github.com/Rukafuu/weebui)
gpui-vrm/

# Genéricos de build — nada de dependências nem build no git da raiz
node_modules/
dist/
.neon
