# Copie para .env nesta pasta e preencha. Nunca versione o .env real.
#
# POSTGRES_PASSWORD  senha do banco interno do n8n. O valor tem de ser o mesmo com que
#                    o volume n8n_postgres_data foi inicializado; colocar outra senha
#                    aqui nao altera o banco existente -- so impede o n8n de conectar.
#                    Antes desta parametrizacao o valor estava fixo no compose; migre-o
#                    para ca sem troca, ou rode a stack do zero.

POSTGRES_PASSWORD=
