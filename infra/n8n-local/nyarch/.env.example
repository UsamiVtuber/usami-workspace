# Copie para ~/n8n/.env no Nyarch e preencha (chmod 600). Nunca versione o .env real.
#
# N8N_SANDBOX_SERVICE_API_KEY  deve ser igual ao valor de SANDBOX_API_KEYS em
#                               ~/n8n-sandbox/.env (a mesma chave nos dois arquivos).
# SEARXNG_SECRET               gere um: openssl rand -hex 32
# USAMI_POSTGRES_PASSWORD      senha forte para o banco da aplicacao (observabilidade + bot Discord)
# N8N_WEBHOOK_SECRET           mesmo segredo usado no .env da Usami (HMAC dos webhooks)
# N8N_OBSERVABILITY_API_KEY    chave de API do n8n (Settings -> n8n API) para o coletor de execucoes

N8N_SANDBOX_SERVICE_API_KEY=
SEARXNG_SECRET=
USAMI_POSTGRES_PASSWORD=
N8N_WEBHOOK_SECRET=
N8N_OBSERVABILITY_API_KEY=

# Bot Discord da Usami (micro-bridge Gateway + webhooks)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_SUGGESTIONS_CHANNEL_ID=
DISCORD_MOD_LOG_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_OBS_ERRORS_CHANNEL_ID=
DISCORD_OBS_SUMMARY_CHANNEL_ID=
