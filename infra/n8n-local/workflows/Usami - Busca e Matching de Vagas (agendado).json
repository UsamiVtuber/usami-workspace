    {
      "id": "f92f0d7f-972c-47dc-b5bc-dd77e6da7301",
      "name": "Calcular Score ATS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        720,
        128
      ],
      "parameters": {
        "jsCode": "\nconst vagas = $input.all();\nconst keywordsPositivos = [\n  'ai engineer', 'backend', 'software engineer', 'full stack', 'full-stack', 'devops', 'data engineer',\n  'python', 'fastapi', 'node.js', 'fastify', 'typescript', 'go', 'java', 'rest', 'api', 'jwt',\n  'llm', 'mcp', 'embeddings', 'rag', 'multiagent', 'docker', 'kubernetes',\n  'postgresql', 'mysql', 'sql', 'redis', 'supabase', 'github actions', 'ci/cd', 'git',\n  'back-end', 'backend', 'microsserviços', 'microservices', 'arquitetura', 'cloud', 'aws',\n  'linux', 'remoto', 'remote', 'home office',\n  'pleno', 'senior', 'sênior', 'sr.', 'lead'\n];\nconst keywordsNegativos = ['java', 'presencial', 'on-site', 'onsite'];\n\nreturn vagas.map((item) => {\n  const json = item.json;\n  const texto = [\n    json.position || json.title || '',\n    json.description || '',\n    json.location || ''\n  ].join(' ').toLowerCase();\n\n  let score = 0;\n\n  if (/ai engineer|backend|software engineer|full.?stack|devops|data engineer/.test(json.position?.toLowerCase() || json.title?.toLowerCase() || '')) {\n    score += 30;\n  }\n\n  const stackMatches = keywordsPositivos.filter(k => texto.includes(k)).length;\n  score += Math.min(stackMatches * 4, 40);\n\n  if (/pleno|senior|sênior/.test(texto)) {\n    score += 15;\n  }\n\n  if (/remoto|remote|home office/.test(texto)) {\n    score += 15;\n  }\n\n  if (/java\b/.test(texto) && !/javascript|typescript/.test(texto)) {\n    score -= 50;\n  }\n  if (/presencial|on.?site/.test(texto)) {\n    score -= 30;\n  }\n\n  score = Math.max(0, Math.min(100, score));\n\n  return {\n    ...json,\n    score_ats: score,\n    candidatura_id: json.id || json.apply_url || json.url || Date.now().toString(),\n  };\n});\n      "
      }
    },
    {
      "id": "d3de9de2-f13d-4cb7-a538-8b994bd39a63",
