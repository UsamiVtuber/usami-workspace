    {
      "id": "c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "Preparar Mensagem Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1840,
        128
      ],
      "parameters": {
        "jsCode": "\nconst itens = $input.all();\nif (!itens || itens.length === 0) {\n  return [];\n}\n\nconst topo = itens\n  .sort((a, b) => (b.json.score_ats || 0) - (a.json.score_ats || 0));\n\nlet blocos = [];\nlet totalCaracteres = 0;\nlet exibidas = 0;\n\nfor (const i of topo) {\n  const j = i.json;\n  const empresa = j.empresa || j.company || 'Empresa';\n  const cargo = j.cargo || j.position || j.title || 'Vaga';\n  const score = j.score_ats ?? 0;\n  const link = j.link_vaga || j.apply_url || j.url || '';\n  const linkFormatado = link ? `\\n   🔗 <${link}>` : '';\n  const itemStr = `🎯 **${empresa}** — ${cargo} (Score ATS: **${score}**)${linkFormatado}`;\n\n  if (blocos.length >= 10 || (totalCaracteres + itemStr.length) > 1700) {\n    break;\n  }\n  blocos.push(itemStr);\n  totalCaracteres += itemStr.length;\n  exibidas++;\n}\n\nconst total = itens.length;\nconst extra = total > exibidas ? `\\n\\n_...e mais ${total - exibidas} nova(s) vaga(s) salvas no controle!_` : '';\nconst cabecalho = `📢 **Novas Vagas Encontradas (${total})**\\n\\n`;\nconst conteudo = cabecalho + blocos.join('\\n\\n') + extra;\n\nreturn [{ json: { content: conteudo } }];\n"
      }
    },
