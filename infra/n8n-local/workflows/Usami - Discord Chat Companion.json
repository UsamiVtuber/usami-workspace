  "id": "8fRPLku2ViH8VutQ",
  "name": "Usami - Discord Chat Companion",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "usami-discord-chat",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "dc-chat-0001-4000-8000-000000000001",
      "name": "Receber Mensagem Discord",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "usami-discord-chat-webhook"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = (raw && typeof raw.body === 'object' && raw.body !== null) ? raw.body : raw;\nconst content = String(body.content || '').trim();\nconst author = body.author || {};\nconst authorName = String(author.globalName || author.username || 'amigo').trim();\nconst channelId = String(body.channelId || '').trim();\nconst messageId = String(body.messageId || '').trim();\nconst guildId = body.guildId ? String(body.guildId) : null;\nconst isDm = Boolean(body.isDm || !guildId);\nconst media = (body.media && typeof body.media === 'object' && (body.media.data || body.media.url)) ? body.media : null;\n\nif (!content && !media) {\n  throw new Error('Evento discord.chat_message sem content nem media.');\n}\nif (!channelId) {\n  throw new Error('Evento discord.chat_message sem channelId.');\n}\n\nconst userText = content || (media ? 'Dá uma olhada nisso aqui!' : '');\nconst usamiMessage = `[Discord | ${authorName}]: ${userText}`.slice(0, 1800);\n\nreturn [{\n  json: {\n    channelId,\n    messageId,\n    guildId,\n    isDm,\n    authorName,\n    content: userText,\n    usamiMessage,\n    hasMedia: Boolean(media),\n    media\n  }\n}];"
      },
      "id": "dc-chat-0002-4000-8000-000000000002",
      "name": "Extrair Mensagem Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $json.hasMedia ? 'http://10.42.0.1:8787/api/media/analyze' : 'http://10.42.0.1:8787/api/chat' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Origin",
              "value": "http://127.0.0.1:5173"
            },
            {
              "name": "x-usami-client",
              "value": "={{ 'discord-' + $json.channelId }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.hasMedia ? { mimeType: $json.media.mimeType, data: $json.media.data, url: $json.media.url, filename: $json.media.filename, prompt: $json.usamiMessage } : { message: $json.usamiMessage }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "dc-chat-0003-4000-8000-000000000003",
      "name": "Chamar API Usami",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wDuW9xOBtCooZtN2",
          "name": "Usami Token"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const apiRes = $input.first().json || {};\nconst ctx = $('Extrair Mensagem Discord').item.json;\n\nconst rawReply = typeof apiRes.reply === 'string' ? apiRes.reply.trim() : '';\nconst isOffline = Boolean(apiRes.error || !rawReply);\n\nconst cleanReply = rawReply\n  .replace(/<(laugh|chuckle|sigh|short pause)>/gi, '')\n  .replace(/\\[(risada|suspiro)\\]/gi, '')\n  .trim();\n\nconst finalText = !isOffline && cleanReply\n  ? cleanReply.slice(0, 1950)\n  : `Oi ${ctx.authorName}! Meu PC principal parece estar descansando agora e não consegui acessar meu núcleo de voz/memória. Tenta de novo daqui a pouquinho, tá?`;\n\nconst discordBody = {\n  content: finalText,\n  allowed_mentions: { replied_user: false }\n};\nif (!ctx.isDm && ctx.messageId) {\n  discordBody.message_reference = {\n    message_id: ctx.messageId,\n    fail_if_not_exists: false\n  };\n}\n\nreturn [{\n  json: {\n    channelId: ctx.channelId,\n    isOffline,\n    discordBody\n  }\n}];"
      },
      "id": "dc-chat-0004-4000-8000-000000000004",
      "name": "Formatar Resposta ou Fallback Offline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://discord.com/api/v10/channels/' + $json.channelId + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.discordBody) }}",
        "options": {
          "timeout": 5000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "dc-chat-0005-4000-8000-000000000005",
      "name": "Responder no Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "discordBotTokenCred",
          "name": "Discord Bot Token"
        }
      }
    }
  ],
